{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus 数据源（指标）",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_TRACING",
      "label": "Tracing",
      "description": "Trace 数据源（Tempo / Jaeger，可选；用于跳转到 TraceExtension v2 产生的 Span）",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Scrapy-Go 爬虫框架监控面板 — Spider 概览 / 请求延迟 / 错误率 / 队列深度 / Item 产出链路 / 分布式追踪（适配 TraceExtension v2，v1.3.0+）",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "📖 TraceExtension v2 设计文档",
      "url": "https://git.woa.com/scrapy-go/scrapy-go/-/blob/master/contrib/telemetry/README.md",
      "type": "link",
      "icon": "doc",
      "targetBlank": true,
      "tooltip": "查看 TraceExtension v2 重构设计与使用指南"
    },
    {
      "title": "🔍 跳转到 Trace 后端",
      "url": "/explore?left=%7B%22datasource%22%3A%22${DS_TRACING}%22%2C%22queries%22%3A%5B%7B%22query%22%3A%22%7B.spider.name%3D%5C%22${spider:raw}%5C%22%7D%22%7D%5D%7D",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "tooltip": "在 Tempo / Jaeger 中查询当前 Spider 的 Trace（spider.crawl 根 Span）"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "🕷️ Spider 概览",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "已停止" } }, "type": "value" },
            { "options": { "1": { "text": "运行中" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_spider_state{spider=~\"$spider\"}",
          "legendFormat": "{{spider}}"
        }
      ],
      "title": "Spider 状态",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3600 },
              { "color": "red", "value": 7200 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_spider_elapsed_seconds{spider=~\"$spider\"}",
          "legendFormat": "{{spider}}"
        }
      ],
      "title": "运行时长",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_requests_total{spider=~\"$spider\"}",
          "legendFormat": "{{spider}}"
        }
      ],
      "title": "总请求数",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_responses_total{spider=~\"$spider\"}",
          "legendFormat": "{{spider}}"
        }
      ],
      "title": "总响应数",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_items_scraped_total{spider=~\"$spider\"}",
          "legendFormat": "{{spider}}"
        }
      ],
      "title": "已抓取 Items",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_errors_total{spider=~\"$spider\"}",
          "legendFormat": "{{spider}}"
        }
      ],
      "title": "总错误数",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "title": "⚡ 请求延迟",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.50, rate(scrapy_request_duration_seconds_bucket{spider=~\"$spider\"}[$__rate_interval]))",
          "legendFormat": "p50 {{spider}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.90, rate(scrapy_request_duration_seconds_bucket{spider=~\"$spider\"}[$__rate_interval]))",
          "legendFormat": "p90 {{spider}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.99, rate(scrapy_request_duration_seconds_bucket{spider=~\"$spider\"}[$__rate_interval]))",
          "legendFormat": "p99 {{spider}}"
        }
      ],
      "title": "请求延迟分位数 (P50/P90/P99)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 12,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(scrapy_requests_total{spider=~\"$spider\"}[$__rate_interval])",
          "legendFormat": "请求 QPS {{spider}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(scrapy_responses_total{spider=~\"$spider\"}[$__rate_interval])",
          "legendFormat": "响应 QPS {{spider}}"
        }
      ],
      "title": "请求/响应吞吐量 (QPS)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 20,
      "title": "🚨 错误率",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 21,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(scrapy_errors_total{spider=~\"$spider\"}[$__rate_interval]) / (rate(scrapy_requests_total{spider=~\"$spider\"}[$__rate_interval]) > 0)",
          "legendFormat": "错误率 {{spider}}"
        }
      ],
      "title": "错误率 (Errors / Requests)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 22,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(scrapy_errors_total{spider=~\"$spider\"}[$__rate_interval])",
          "legendFormat": "错误 {{spider}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(scrapy_items_dropped_total{spider=~\"$spider\"}[$__rate_interval])",
          "legendFormat": "丢弃 {{spider}}"
        }
      ],
      "title": "错误 & Item 丢弃速率",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 30,
      "title": "📊 队列深度 & 活跃请求",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 31,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_active_requests{spider=~\"$spider\"}",
          "legendFormat": "活跃请求 {{spider}}"
        }
      ],
      "title": "活跃请求数",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 32,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_scheduler_queue_size{spider=~\"$spider\"}",
          "legendFormat": "队列深度 {{spider}}"
        }
      ],
      "title": "调度器队列深度",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 40,
      "title": "🌐 按域名维度",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "id": 41,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(scrapy_requests_total{spider=~\"$spider\", domain=~\"$domain\"}[$__rate_interval])",
          "legendFormat": "{{domain}}"
        }
      ],
      "title": "按域名请求 QPS",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "id": 42,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.90, rate(scrapy_request_duration_seconds_bucket{spider=~\"$spider\", domain=~\"$domain\"}[$__rate_interval]))",
          "legendFormat": "p90 {{domain}}"
        }
      ],
      "title": "按域名请求延迟 P90",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 50,
      "title": "📦 Item 产出链路（TraceExtension v2 核心模型）",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Item 在 Pipeline 中的产出/丢弃/错误速率。对应 TraceExtension v2 的 item.pipeline Span 的 pipeline.success / pipeline.dropped / pipeline.error Event。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "id": 51,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "sum", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(scrapy_items_scraped_total{spider=~\"$spider\"}[$__rate_interval])",
          "legendFormat": "已抓取 {{spider}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "rate(scrapy_items_dropped_total{spider=~\"$spider\"}[$__rate_interval])",
          "legendFormat": "已丢弃 {{spider}}"
        }
      ],
      "title": "Item 产出 / 丢弃速率",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Item Pipeline 成功率 = scraped / (scraped + dropped)。低于 95% 时建议在 Trace 中查看 item.pipeline Span 的 pipeline.dropped Event 定位原因。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "id": 52,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (spider) (rate(scrapy_items_scraped_total{spider=~\"$spider\"}[$__rate_interval])) / clamp_min(sum by (spider) (rate(scrapy_items_scraped_total{spider=~\"$spider\"}[$__rate_interval]) + rate(scrapy_items_dropped_total{spider=~\"$spider\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{spider}}"
        }
      ],
      "title": "Item Pipeline 成功率",
      "type": "gauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "已抓取 Item 累计数量。对应 TraceExtension v2 中带 pipeline.success Event 的 item.pipeline Span 数量。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 50 },
      "id": 53,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "scrapy_items_scraped_total{spider=~\"$spider\"}",
          "legendFormat": "{{spider}}"
        }
      ],
      "title": "已抓取 Item 总数",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "已丢弃 Item 累计数量。对应 TraceExtension v2 中带 pipeline.dropped Event 的 item.pipeline Span 数量。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
